{
  "name": "dsh-conversation-tree",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A zoomable conversation-tree management view with branch lineage, own token usage, model, bring-back, archive, and subtree deletion.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "conversation-tree",
    "branch",
    "fork"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test conversation-tree.test.js client.test.js branch.test.js"
  }
}
