{
  "name": "dsh-conversation-tree",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A workspace-wide conversation-tree view for DeepSeek Harness: every conversation and every branch in one page, with its source turn, its own usage, bring-back, archive and subtree deletion.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "conversation-tree",
    "branch",
    "fork"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test conversation-tree.test.js client.test.js branch.test.js"
  },
  "author": "The dsh-conversation-tree authors"
}
